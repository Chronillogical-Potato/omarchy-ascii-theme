# ASCII for btop: ink and paper, with amber reserved for load and heat.

theme[main_bg]="#0d0d0c"
theme[main_fg]="#cfccc4"
theme[title]="#f4f1e8"
theme[hi_fg]="#f0a640"
theme[selected_bg]="#2b2a27"
theme[selected_fg]="#f4f1e8"
theme[inactive_fg]="#807d76"
theme[graph_text]="#a8a59d"
theme[meter_bg]="#2b2a27"
theme[proc_misc]="#a8a59d"

# Box outlines stay quiet so the data carries the page.
theme[cpu_box]="#55534e"
theme[mem_box]="#55534e"
theme[net_box]="#55534e"
theme[proc_box]="#55534e"
theme[div_line]="#2b2a27"

# Graphs climb from graphite to paper; only the top of the range turns amber.
theme[temp_start]="#6f6c66"
theme[temp_mid]="#cfccc4"
theme[temp_end]="#f0a640"

theme[cpu_start]="#6f6c66"
theme[cpu_mid]="#cfccc4"
theme[cpu_end]="#f0a640"

theme[free_start]="#55534e"
theme[free_mid]="#6f6c66"
theme[free_end]="#a8a59d"

theme[cached_start]="#55534e"
theme[cached_mid]="#6f6c66"
theme[cached_end]="#a8a59d"

theme[available_start]="#6f6c66"
theme[available_mid]="#a8a59d"
theme[available_end]="#cfccc4"

theme[used_start]="#6f6c66"
theme[used_mid]="#cfccc4"
theme[used_end]="#f0a640"

theme[download_start]="#55534e"
theme[download_mid]="#a8a59d"
theme[download_end]="#f4f1e8"

theme[upload_start]="#55534e"
theme[upload_mid]="#a8a59d"
theme[upload_end]="#f0a640"

theme[process_start]="#6f6c66"
theme[process_mid]="#cfccc4"
theme[process_end]="#f0a640"
